# RDP Starter Kit Environment Variables
# Copy ini menjadi .env dan sesuaikan dengan environment Anda
# US-002: Konfigurasi environment via `.env`

# ⚙️ WHITE LABEL
# Brand bisa dikustom — clone project baru, isi ini, langsung jalan
SITE_NAME=RDP Starter Kit
COMPANY_NAME=Radian Data Platform
APP_BRAND_SHORT=RDP
COPYRIGHT_YEAR=2026

# ⚙️ DJANGO CORE
SECRET_KEY=your-super-secret-key-change-this-in-production-please-generate-random-string
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
RDP_UI_VERSION=v1.0
RDP_UI_SELF_HOST=False
RDP_APP_ACCENT=navy

# ⚙️ DATABASE
# Development: sqlite:///db.sqlite3
# Production: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3

# ⚙️ CACHE
# Development: locmem:// (local memory, tidak perlu Redis)
# Production: redis://redis.example.com:6379/0
CACHE_URL=locmem://

# ⚙️ EMAIL BACKEND
# Options: console (print to terminal), mailpit (localhost:1025), smtp (production)
EMAIL_BACKEND=console
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@radianapp.com

# ⚙️ CORS
# Daftar domain yang boleh make request ke API
CORS_ALLOWED_ORIGINS=

# ⚙️ LOGGING
LOG_LEVEL=INFO

# ⚙️ SECURITY (Production only)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ⚙️ REGISTRATION WIZARD
# Default kosong = wizard hanya 2 step (email + password)
# Tambah step custom dengan format JSON array:
# REGISTRATION_STEPS=[{"key":"full_name","label":"Nama Lengkap","type":"text","required":true},{"key":"role","label":"Role","type":"select","required":true,"choices":["Developer","Manager","Owner"]}]
# Tipe field: text, email, textarea, select (butuh "choices": [...])
REGISTRATION_STEPS=[]

# ⚙️ EMAIL VERIFICATION (US-008)
# ------------------------------------------------------------------------------
# AUTH & REGISTRATION
# ------------------------------------------------------------------------------
ENABLE_USER_REGISTRATION=True
ENABLE_GOOGLE_AUTH=False
ENABLE_AUDIT_TRAIL=True
REQUIRE_EMAIL_VERIFICATION=False

# Batasi pendaftaran hanya untuk domain tertentu (pisahkan dengan koma). Kosongkan untuk izinkan semua.
ALLOWED_EMAIL_DOMAINS=perusahaan.com,anakperusahaan.com

# ⚙️ KONFIGURASI: CELERY
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ⚙️ KONFIGURASI: CLOUD STORAGE (S3 / MinIO)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=
AWS_S3_VERIFY=False

# sT,? KONFIGURASI: CLOUDFLARE TURNSTILE (CAPTCHA)
TURNSTILE_ENABLED=False
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
